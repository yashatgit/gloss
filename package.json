{
  "name": "gloss",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "electron:dev": "pnpm --filter @gloss/desktop electron",
    "desktop:build": "pnpm --filter @gloss/client build && pnpm --filter @gloss/desktop build",
    "desktop:start": "pnpm run desktop:build && pnpm --filter @gloss/desktop start"
  },
  "packageManager": "pnpm@11.5.2"
}
